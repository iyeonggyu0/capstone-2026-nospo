# 개발 서버가 /api 요청을 전달할 백엔드 주소입니다.
VITE_API_DEVELOPMENT_URL=http://localhost:8080

# Vercel Production 환경에 등록할 배포 백엔드 주소입니다.
VITE_API_PRODUCTION_URL=https://api.example.com

# Axios 요청 제한 시간(밀리초)입니다.
VITE_API_TIMEOUT=100000

# 위키 API 배포 전에는 목업을 사용하고, 위키 엔드포인트가 배포되면 api로 변경합니다.
VITE_WIKI_API_MODE=mock
